# ============================================================================
# financial-prompt-agent — exemplo de variáveis de ambiente
# ----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha apenas os provedores que for usar.
# NUNCA versione o arquivo `.env` real com chaves preenchidas.
# ============================================================================

# ----------------------------------------------------------------------------
# Aplicação
# ----------------------------------------------------------------------------
APP_NAME=financial-prompt-agent
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# Modelo padrão usado quando nenhum é especificado na requisição.
# Use "fake" para desenvolvimento/testes sem custo e sem internet.
# ----------------------------------------------------------------------------
DEFAULT_PROVIDER=fake
DEFAULT_MODEL=fake-model
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=1024
DEFAULT_TIMEOUT=60

# ----------------------------------------------------------------------------
# Credenciais dos provedores de LLM (carregadas por ambiente).
# Deixe em branco os que não for usar. Nenhum modelo é obrigatório.
# NÃO fixe versões de modelos aqui que possam ficar obsoletas — configure-os
# em app/config/models.yaml ou na requisição/arquivo experimental.
# ----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# OpenRouter usa uma base URL compatível com a API da OpenAI:
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ----------------------------------------------------------------------------
# Exemplos de modelos por provedor (apenas ilustrativos — ajuste conforme a
# disponibilidade atual de cada API; não copie cegamente identificadores que
# possam estar descontinuados):
#
#   openai      -> um modelo de chat atual da OpenAI
#   anthropic   -> um modelo Claude atual
#   google      -> um modelo Gemini atual
#   openrouter  -> "<owner>/<model>" conforme o catálogo do OpenRouter
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Fonte de dados financeiros:
#   live     -> consulta dados reais (yfinance)
#   snapshot -> lê arquivos locais em data/snapshots/ (usado nos experimentos)
# ----------------------------------------------------------------------------
MARKET_DATA_SOURCE=snapshot
SNAPSHOT_SET=default

# ----------------------------------------------------------------------------
# URL do backend usada pela interface Streamlit para chamar a API.
# ----------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
